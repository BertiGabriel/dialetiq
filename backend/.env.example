# Copy to backend/.env and fill in. NEVER commit the resulting .env.
#
# Production values live in the secret manager and in GitHub Environment
# Secrets -- scoped to the `production` environment, so a workflow running on a
# pull request branch cannot read them. That closes the classic exfiltration
# path: open a PR that prints the secrets to the build log.

DIALETIQ_ENVIRONMENT=development

# Local Docker Postgres. In production this is Neon's POOLED endpoint
# (the host contains `-pooler`).
DIALETIQ_DATABASE_URL=postgresql+psycopg://dialetiq:dialetiq@localhost:5432/dialetiq

# Migrations only. Must be Neon's DIRECT endpoint -- Alembic needs session-level
# state that PgBouncer's transaction mode does not provide.
DIALETIQ_MIGRATION_DATABASE_URL=

DIALETIQ_REDIS_URL=redis://localhost:6379/0

# Signs the admin session cookie. Rotating it signs everyone out -- which is the
# intended behaviour after a compromise.
DIALETIQ_SESSION_SECRET=dev-only-do-not-use-in-production

# Peppers the consumer phone/email HMACs. In production this comes from the
# secret manager and nowhere else.
#
# If this leaks together with a database dump, the entire consumer base becomes
# reidentifiable in minutes: Brazilian mobile numbers span ~10^9 values and
# HMAC-SHA256 is fast enough to enumerate all of them.
DIALETIQ_IDENTITY_PEPPER=dev-only-do-not-use-in-production
