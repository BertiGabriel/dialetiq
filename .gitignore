# ==========================================================================
# SECRETS — never commit.
# A secret committed to git is in the history forever, even after you delete
# it. The only remediation is to revoke it and issue a new one.
# ==========================================================================
.env
.env.*
!.env.example
*.pem
*.key

# Signing and push keys (Apple / Google)
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
key.properties

# Firebase
google-services.json
GoogleService-Info.plist
firebase-service-account*.json
serviceAccountKey.json

# Infrastructure credentials
*.tfvars
!*.tfvars.example
kubeconfig
.terraform/
*.tfstate
*.tfstate.*

# ==========================================================================
# Python / backend
# ==========================================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ==========================================================================
# Flutter / mobile
# ==========================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/build/
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/local.properties
*.iml

# ==========================================================================
# OS and editors
# ==========================================================================
.DS_Store
Thumbs.db
.idea/
*.swp

# Shared project settings are versioned; personal preferences are not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.claude/settings.local.json
